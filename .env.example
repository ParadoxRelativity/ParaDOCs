# --- Docker Compose ---
# Only these are read by docker-compose.yml. The app's own settings are passed
# to the container by compose, so DATABASE_URL below is for local dev only.
POSTGRES_PASSWORD=
# Host port and interface the app is published on.
PORT=4000
BIND_ADDR=0.0.0.0
# Only for the TLS overlay: the hostname Caddy gets a certificate for.
DOMAIN=

# --- Database (local development) ---
DATABASE_URL=postgres://michael@localhost:5432/paradocs

# --- API ---
API_PORT=4000
# 32+ random bytes. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
# Comma-separated origins allowed to call the API with credentials
CORS_ORIGIN=http://localhost:5173
# Set to "true" behind HTTPS so session cookies are marked Secure
SECURE_COOKIES=false
# Where uploaded attachments are written
UPLOAD_DIR=./data/uploads
# Set to "false" once your account exists to close public registration
ALLOW_REGISTRATION=true

# --- OIDC single sign-on (Phase 2; the routes are stubbed today) ---
# Set these to prepare a deployment. Sign-in still uses email and password until
# the flow is implemented; the login screen shows SSO as unavailable.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:4000/api/auth/oidc/callback
OIDC_PROVIDER_NAME=SSO

# --- Web ---
VITE_API_URL=http://localhost:4000
