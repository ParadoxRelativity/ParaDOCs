# --- Docker Compose ---
# Only these are read by docker-compose.yml. The app's own settings are passed
# to the container by compose, so DATABASE_URL below is for local dev only.
POSTGRES_PASSWORD=
# Set to https to run Caddy in front, with automatic certificates.
#COMPOSE_PROFILES=
# Host port and interface the app is published on.
PORT=4000
BIND_ADDR=0.0.0.0
# Host port and interface the server admin page is published on. Keep it on
# 127.0.0.1 and reach it over an SSH tunnel.
ADMIN_BIND_ADDR=127.0.0.1
# Only for the https profile: the hostname Caddy gets a certificate for.
DOMAIN=

# --- Database (local development) ---
DATABASE_URL=postgres://michael@localhost:5432/paradocs

# --- API ---
API_PORT=4000
# 32+ random bytes. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
# Comma-separated origins allowed to call the API with credentials
CORS_ORIGIN=http://localhost:5173
# Set to "true" behind HTTPS so session cookies are marked Secure
SECURE_COOKIES=false
# Set to "true" when the app is reachable only through a reverse proxy (such as
# the https profile with BIND_ADDR=127.0.0.1), so sign-in rate limits see real
# client addresses. Leave false when the app is published directly.
TRUST_PROXY=false
# Where uploaded attachments are written
UPLOAD_DIR=./data/uploads
# Largest file anyone can upload, in megabytes: chat, documents and canvases alike
MAX_UPLOAD_MB=25
# Whether public registration starts open. Once it is changed on the server
# admin page, that setting is used instead.
ALLOW_REGISTRATION=true
# Whether the server checks GitHub for newer releases and tells server
# administrators, in their notifications and on the admin page. Set to "false"
# for a server that should not reach GitHub.
UPDATE_CHECK=true
# The repository whose releases are checked. A fork points this at its own.
UPDATE_CHECK_REPO=ParadoxRelativity/ParaDOCs

# --- Server admin page ---
# Server-wide settings and account management, on a port of its own. The first
# account to sign in there, or to be created there, becomes the administrator.
# In development it is also at http://localhost:5173/admin.html.
ADMIN_ENABLED=true
# Port the admin page listens on (and, with Docker, the host port it is published on)
ADMIN_PORT=4001
# Interface it listens on outside Docker. Keep it internal.
ADMIN_HOST=127.0.0.1
# Set to "true" only if the admin page itself is served over HTTPS
ADMIN_SECURE_COOKIES=false

# --- Single sign-on (OpenID Connect) ---
# The address people reach ParaDOCs at. Providers send people back to
# $PUBLIC_URL/api/auth/oidc/<short name>/callback, so set it before adding one.
# In local development that is the Vite origin, http://localhost:5173.
PUBLIC_URL=
# Providers are normally added on the server admin page. One can also be given
# here; the admin page shows it but cannot change it. It is on only with
# OIDC_ENABLED=true, so the settings below can be filled in ahead of time.
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=SSO
# The provider's short name, in its redirect URI.
OIDC_SLUG=sso
# Overrides the redirect URI worked out from PUBLIC_URL.
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid email profile
# Who it may make new accounts for: registration (follow the registration
# setting), always (even with registration closed), or never.
OIDC_NEW_ACCOUNTS=registration
# Comma-separated email domains allowed to sign in with it; empty allows any.
OIDC_ALLOWED_DOMAINS=
# Take its emails as verified even though it does not say so, as Microsoft
# Entra ID does not. Needs OIDC_ALLOWED_DOMAINS.
OIDC_TRUST_EMAILS=false

# --- Web ---
VITE_API_URL=http://localhost:4000

# --- Voice and video ----------------------------------------------------------
# On by default in docker-compose.yml, with nothing to set: the app generates
# LiveKit's keys and relays its signalling. Open UDP 7882 and TCP 7881 for media.
#
# Turn voice and video off:
#VOICE_ENABLED=false
# The public address browsers send call media to. LiveKit finds it through a
# public STUN server; set it where that fails or gives the wrong answer, such as
# a server used only on a private network.
#LIVEKIT_NODE_IP=
# Fixed keys instead of generated ones. Set both or neither.
#LIVEKIT_API_KEY=
#LIVEKIT_API_SECRET=
#
# Outside Docker, such as in local development, point the API at a LiveKit
# server browsers can reach, e.g. `livekit-server --dev` (keys devkey/secret):
#LIVEKIT_URL=ws://localhost:7880
#LIVEKIT_API_KEY=devkey
#LIVEKIT_API_SECRET=secret
# The Chat sidebar learns who joins and leaves voice channels from LiveKit's
# webhook, which Docker sets up. Elsewhere, start LiveKit with `--config` and a
# file containing:
#   webhook:
#     api_key: devkey
#     urls: [http://localhost:4000/api/voice/webhook]
