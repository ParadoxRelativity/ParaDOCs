# --- Docker Compose ---
# Only these are read by docker-compose.yml. The app's own settings are passed
# to the container by compose, so DATABASE_URL below is for local dev only.
POSTGRES_PASSWORD=
# Set to https to run Caddy in front, with automatic certificates.
#COMPOSE_PROFILES=
# Host port and interface the app is published on.
PORT=4000
BIND_ADDR=0.0.0.0
# Only for the https profile: the hostname Caddy gets a certificate for.
DOMAIN=

# --- Database (local development) ---
DATABASE_URL=postgres://michael@localhost:5432/paradocs

# --- API ---
API_PORT=4000
# 32+ random bytes. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
# Comma-separated origins allowed to call the API with credentials
CORS_ORIGIN=http://localhost:5173
# Set to "true" behind HTTPS so session cookies are marked Secure
SECURE_COOKIES=false
# Where uploaded attachments are written
UPLOAD_DIR=./data/uploads
# Largest file anyone can upload, in megabytes: chat, documents and canvases alike
MAX_UPLOAD_MB=25
# Set to "false" once your account exists to close public registration
ALLOW_REGISTRATION=true

# --- OIDC single sign-on (Phase 2; the routes are stubbed today) ---
# Set these to prepare a deployment. Sign-in still uses email and password until
# the flow is implemented; the login screen shows SSO as unavailable.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:4000/api/auth/oidc/callback
OIDC_PROVIDER_NAME=SSO

# --- Web ---
VITE_API_URL=http://localhost:4000

# --- Voice and video ----------------------------------------------------------
# On by default in docker-compose.yml, with nothing to set: the app generates
# LiveKit's keys and relays its signalling. Open UDP 7882 and TCP 7881 for media.
#
# Turn voice and video off:
#VOICE_ENABLED=false
# The public address browsers send call media to. LiveKit finds it through a
# public STUN server; set it where that fails or gives the wrong answer, such as
# a server used only on a private network.
#LIVEKIT_NODE_IP=
# Fixed keys instead of generated ones. Set both or neither.
#LIVEKIT_API_KEY=
#LIVEKIT_API_SECRET=
#
# Outside Docker, such as in local development, point the API at a LiveKit
# server browsers can reach, e.g. `livekit-server --dev` (keys devkey/secret):
#LIVEKIT_URL=ws://localhost:7880
#LIVEKIT_API_KEY=devkey
#LIVEKIT_API_SECRET=secret
# The Chat sidebar learns who joins and leaves voice channels from LiveKit's
# webhook, which Docker sets up. Elsewhere, start LiveKit with `--config` and a
# file containing:
#   webhook:
#     api_key: devkey
#     urls: [http://localhost:4000/api/voice/webhook]
