{
  "name": "paradocs",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted, open-source document management system",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@paradocs/api & npm run dev --workspace=@paradocs/web",
    "dev:api": "npm run dev --workspace=@paradocs/api",
    "dev:web": "npm run dev --workspace=@paradocs/web",
    "build": "npm run build --workspace=@paradocs/shared && npm run build --workspace=@paradocs/api && npm run build --workspace=@paradocs/web",
    "migrate": "npm run migrate --workspace=@paradocs/api",
    "seed": "npm run seed --workspace=@paradocs/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "desktop": "npm run start --workspace=@paradocs/desktop",
    "desktop:dev": "npm run dev --workspace=@paradocs/desktop",
    "desktop:dist:mac": "npm run dist:mac --workspace=@paradocs/desktop",
    "desktop:dist:win": "npm run dist:win --workspace=@paradocs/desktop",
    "mobile:ios": "npm run ios --workspace=@paradocs/mobile",
    "mobile:android": "npm run android --workspace=@paradocs/mobile"
  }
}
