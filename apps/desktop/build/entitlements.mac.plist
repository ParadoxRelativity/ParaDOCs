<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Chromium's JavaScript engine and PGlite's WebAssembly both need to map
         executable pages, which the hardened runtime blocks by default. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Electron loads its own framework libraries. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Voice channels. Under the hardened runtime, macOS neither prompts for
         nor lists an app in Privacy settings without these. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.device.camera</key>
    <true/>
  </dict>
</plist>
