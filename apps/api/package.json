{
  "name": "@paradocs/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "comment": "Consumed as TypeScript source by the desktop app, which bundles the API into its main process to run local workspaces.",
  "exports": {
    "./app": "./src/app.ts",
    "./config": "./src/config.ts",
    "./collab": "./src/collab/server.ts",
    "./chat": "./src/chat/server.ts",
    "./db/driver": "./src/db/driver.ts",
    "./db/pool": "./src/db/pool.ts",
    "./db/migrate": "./src/db/migrate.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "echo 'api runs from TypeScript source via tsx'",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@blocknote/core": "^0.54.2",
    "@blocknote/server-util": "^0.54.2",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@hocuspocus/server": "^2.15.3",
    "@paradocs/shared": "*",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.4",
    "fastify-plugin": "^6.0.0",
    "livekit-server-sdk": "^2.19.0",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "ws": "^8.21.3",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.18.1",
    "typescript": "^5.6.3"
  }
}
