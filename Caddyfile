# Terminates TLS and proxies to the app container.
# Caddy obtains and renews certificates automatically.
{$DOMAIN} {
	encode zstd gzip

	# Uploaded files can be cached; they are content-addressed by a random name.
	@uploads path /uploads/*
	header @uploads Cache-Control "public, max-age=31536000, immutable"

	# Voice and video signalling, when the `voice` profile is running.
	#
	# LiveKit's clients dial /rtc over a websocket and its management API lives
	# under /twirp, so both can share this certificate and this domain — which
	# is what lets LIVEKIT_URL be wss://$DOMAIN with no second hostname and no
	# second certificate. Media is a different matter: it travels over UDP
	# directly to the container's published port range and cannot pass through
	# an HTTP reverse proxy at all.
	#
	# Inert without the voice profile: nothing requests these paths.
	handle /rtc* {
		reverse_proxy livekit:7880
	}
	handle /twirp/* {
		reverse_proxy livekit:7880
	}

	# Everything else is the app: the SPA, /api, /uploads, and the collaboration
	# and chat websockets, which reverse_proxy passes through unchanged.
	handle {
		reverse_proxy app:4000
	}
}
